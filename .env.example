# Local development config. Copy to .env and it works as-is with the
# dependencies from `docker compose up -d` (see DOCKER-README.md).

APP_ENV=local
APP_DEBUG=true
APP_URL=http://localhost:8000
# Dev-only key so the app boots out of the box. Regenerate with
# `php artisan key:generate` for anything that isn't a local setup.
APP_KEY=base64:O8oDL/1AMZq2dxTskgjeg/2AhvxTYSwmKXfvcErLMq8=

# The *_PORT values below are also used by docker-compose.yaml for the host
# port mappings, so if e.g. 5432 clashes with another project, change it here
# once and both the container and the app follow.
DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=ponyfm
DB_USERNAME=ponyfm
DB_PASSWORD=ponyfm

ELASTICSEARCH_HOST=127.0.0.1
ELASTICSEARCH_PORT=9200

CACHE_DRIVER=file
SESSION_DRIVER=file
SESSION_HTTPS_ONLY=false

# Jobs (transcoding, indexing, notifications) run inline in dev. For a
# prod-like queue: set this to redis, start the queue container with
# `docker compose --profile queue up -d`, and run `composer queue`.
# If your local PHP lacks the phpredis extension, also set REDIS_CLIENT=predis.
QUEUE_CONNECTION=sync

# Mail is written to storage/logs/laravel.log in dev.
MAIL_MAILER=log

# Poniverse OAuth credentials — only needed to test login against Poniverse.
PONI_CLIENT_ID=null
PONI_CLIENT_SECRET=null

# Where uploaded tracks/images are stored.
# Defaults to storage/app/datastore when unset.
#PONYFM_DATASTORE=

# Track/image files are served via X-Accel-Redirect, honoured by the
# FrankenPHP Caddyfile (docker/frankenphp/Caddyfile) in the production image
# and under `php artisan octane:start`. The plain `composer serve` PHP dev
# server does not honour it, so use octane locally to test file streaming.

# ffmpeg & AtomicParsley are found via PATH. `composer serve` and
# `composer queue` prepend docker/bin, whose shims run them via `docker run`,
# so neither needs to be installed locally. Set FFMPEG_PREFIX only if you
# want to override how the encode job invokes ffmpeg.
#FFMPEG_PREFIX=

GOOGLE_ANALYTICS_ID=null

# VAPID keypair for browser push notifications. Optional in dev — push
# notifications are simply disabled when unset. Generate a keypair with
# `vendor/bin/web-push generate-vapid-keys`.
#VAPID_PUBLIC_KEY=
#VAPID_PRIVATE_KEY=

USE_POWERED_BY_FOOTER=false
